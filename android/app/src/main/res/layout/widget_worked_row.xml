<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_tile_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/row_tick"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_worked_tick"
        android:padding="11dp"
        android:src="@drawable/ic_widget_circle" />

    <LinearLayout
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1C1C1E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF5C5C63"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
