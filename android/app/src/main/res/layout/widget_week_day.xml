<?xml version="1.0" encoding="utf-8"?>
<!-- Item 115 J: the week as 7 shaded tiles; tap one to list that day below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wj_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <include layout="@layout/widget_clock_strip" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
        <TextView android:id="@+id/wj_t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
        <TextView android:id="@+id/wj_t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
        <TextView android:id="@+id/wj_t3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
        <TextView android:id="@+id/wj_t4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
        <TextView android:id="@+id/wj_t5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
        <TextView android:id="@+id/wj_t6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
        <TextView android:id="@+id/wj_t7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:textColor="#DD000000" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wj_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="2dp" android:textColor="#DD000000" android:textSize="12sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wj_add" android:layout_width="24dp" android:layout_height="22dp" android:contentDescription="@string/widget_add" android:padding="2dp" android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ListView android:id="@+id/wj_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" />
        <TextView android:id="@+id/wj_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_day_empty" android:textColor="#99000000" android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
