<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#DD000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#99000000"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/n_bar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/n_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#DD000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/n_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99000000"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/n_step1"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/n_tick1"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_tick"
                android:padding="8dp"
                android:src="@drawable/ic_widget_box" />

            <TextView
                android:id="@+id/n_stext1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#DD000000"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_step2"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/n_tick2"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_tick"
                android:padding="8dp"
                android:src="@drawable/ic_widget_box" />

            <TextView
                android:id="@+id/n_stext2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#DD000000"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/n_step3"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/n_tick3"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_tick"
                android:padding="8dp"
                android:src="@drawable/ic_widget_box" />

            <TextView
                android:id="@+id/n_stext3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#DD000000"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/n_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="38dp"
            android:textColor="#99000000"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_buttons"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_outline"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FF2B2B30"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/n_done"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="@string/widget_done"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
