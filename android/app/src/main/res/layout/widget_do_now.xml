<?xml version="1.0" encoding="utf-8"?>
<!-- Item 114 C: the Do now widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/dn_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dn_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#AA000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dn_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#DD000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dn_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#AA000000"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dn_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dn_focus"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/widget_do_now_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_do_now_focus"
            android:textColor="#DD000000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dn_open"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_do_now_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_do_now_open"
            android:textColor="#DD000000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dn_next"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_do_now_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_do_now_next"
            android:textColor="#DD000000"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
