<?xml version="1.0" encoding="utf-8"?>
<!-- Item 115: a task, step or event in a week list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wi_row"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/wi_tick"
        android:layout_width="26dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_tick"
        android:padding="5dp"
        android:src="@drawable/ic_widget_box" />

    <LinearLayout android:id="@+id/wi_text" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingEnd="6dp">
        <TextView android:id="@+id/wi_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#DD000000" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/wi_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="4dp" android:textColor="#CC000000" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
