<?xml version="1.0" encoding="utf-8"?>
<!-- Item 115 B and H: the week as 7 columns; the month button swaps in the month. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <include layout="@layout/widget_clock_strip" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wb_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="2dp" android:textColor="#DD000000" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wb_toggle" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="#99000000" android:textSize="12sp" />
        <ImageView android:id="@+id/wb_add" android:layout_width="24dp" android:layout_height="22dp" android:contentDescription="@string/widget_add" android:padding="2dp" android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <LinearLayout android:id="@+id/wb_names" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/wb_d1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#99000000" android:textSize="9sp" />
            <TextView android:id="@+id/wb_d2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="#99000000" android:textSize="9sp" />
            <TextView android:id="@+id/wb_d3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textColor="#99000000" android:textSize="9sp" />
            <TextView android:id="@+id/wb_d4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="#99000000" android:textSize="9sp" />
            <TextView android:id="@+id/wb_d5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textColor="#99000000" android:textSize="9sp" />
            <TextView android:id="@+id/wb_d6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#99000000" android:textSize="9sp" />
            <TextView android:id="@+id/wb_d7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#99000000" android:textSize="9sp" />
    </LinearLayout>

    <GridView android:id="@+id/wb_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:horizontalSpacing="3dp" android:numColumns="7" android:stretchMode="columnWidth" android:verticalSpacing="2dp" />
</LinearLayout>
