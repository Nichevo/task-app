<?xml version="1.0" encoding="utf-8"?>
<!-- Item 115 I: one row per day of the week: how full it is, and what is on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <include layout="@layout/widget_clock_strip" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wl_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="2dp" android:text="@string/widget_this_week" android:textColor="#DD000000" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wl_add" android:layout_width="24dp" android:layout_height="22dp" android:contentDescription="@string/widget_add" android:padding="2dp" android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <ListView android:id="@+id/wl_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" />
</LinearLayout>
